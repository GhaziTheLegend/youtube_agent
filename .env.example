# Copy this file to `.env` and fill in real values.
# .env is git-ignored - never commit real keys.

# LLM - use ONE of these (Gemini has a free tier, good for prototyping)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# TTS provider (only needed if you upgrade from free edge-tts later)
ELEVENLABS_API_KEY=

# Stock media (Pexels is free - www.pexels.com/api)
PEXELS_API_KEY=

# YouTube / Google Cloud - set up in Phase 4
# Path to the OAuth client secrets JSON you download from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_PATH=./secrets/client_secret.json
YOUTUBE_TOKEN_PATH=./secrets/token.json
